      {
        "selector": "JSXOpeningElement[name.name='ToastOptions'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|title|description|actionLabel|onAction|duration|key|ref|className|style|children)$/]",
        "message": "<ToastOptions> doesn't accept that prop. Declared props: type, title, description, actionLabel, onAction, duration."
      }
    ]
  },
